#!/usr/bin/env bash
# Remove the pila login session that scripts/install put on the host: the
# binary, the session wrapper, the session entry and the portal configs. Give
# it the same PREFIX, SYSCONFDIR, ... as the install (scripts/install-paths).
# Your own files stay: ~/.config/pila,
# ~/.config/xdg-desktop-portal-wlr/pila (scripts/tty) and the logs in
# ~/.local/state/pila.
#
#   scripts/uninstall
set -euo pipefail

cd "$(dirname "$0")/.."
source scripts/install-paths

if [ -z "$DESTDIR" ] && [ "${XDG_SESSION_DESKTOP:-}" = pila ]; then
    echo "This is a pila session. It keeps running after the uninstall (the binary"
    echo "is unlinked, not stopped), but the next login won't offer pila."
    read -r -p "Uninstall anyway? [y/N] " answer
    case "$answer" in
        y | Y | yes) ;;
        *) echo "Nothing removed."; exit 1 ;;
    esac
fi

for entry in "${install_files[@]}"; do
    IFS=: read -r _ target _ <<<"$entry"
    target="$DESTDIR$target"
    if [ -e "$target" ]; then
        as_owner_of "$target" rm -f "$target"
        echo "removed  $target"
    else
        echo "absent   $target"
    fi
done
for dir in "${install_dirs[@]}"; do
    dir="$DESTDIR$dir"
    if [ -d "$dir" ]; then
        as_owner_of "$dir" rmdir --ignore-fail-on-non-empty "$dir"
    fi
done

echo
echo "Uninstalled. Kept: ~/.config/pila, ~/.config/xdg-desktop-portal-wlr/pila, ~/.local/state/pila."
