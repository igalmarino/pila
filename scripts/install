#!/usr/bin/env bash
# Install pila as a login session, on any distro and with any display manager
# that reads wayland-sessions (GDM, SDDM, LightDM, greetd front ends, ...):
# the release binary, the session wrapper, the session entry and the portal
# configs for screen sharing. Run it from your desktop session; sudo asks once
# if the targets aren't writable. Afterwards log out and pick "pila" in the
# login screen's session menu. After changing pila: run it again, then log out
# and back in.
#
#   scripts/install              build the release binary, then install
#   scripts/install --container  build it in the dev container (scripts/dev)
#   scripts/install --no-build   install what's in target/release
#
# The build uses the host's cargo if there is one: a binary built in the dev
# container (Arch) needs Arch's glibc and libraries, which other distros may
# not have. Paths (PREFIX, SYSCONFDIR, DESTDIR, ...) are in
# scripts/install-paths; e.g. PREFIX=/usr scripts/install.
#
# scripts/uninstall removes exactly these files (given the same variables).
# Your own config (scripts/install-config) and logs are separate.
set -euo pipefail

cd "$(dirname "$0")/.."
source scripts/install-paths

build=auto
case "${1:-}" in
    "") ;;
    --container) build=container ;;
    --no-build) build=none ;;
    *) echo "usage: scripts/install [--container | --no-build]" >&2; exit 1 ;;
esac
if [ "$build" = auto ]; then
    if command -v cargo >/dev/null; then build=native; else build=container; fi
fi

case "$build" in
    native) cargo build --release ;;
    container)
        if [ -z "${DEVCONTAINER:-}" ]; then
            echo "Building in the dev container: the binary is linked against Arch's" >&2
            echo "libraries and may not run on another distro (install Rust and build" >&2
            echo "on the host instead, see README.md)." >&2
        fi
        scripts/dev cargo build --release
        ;;
esac
if [ ! -x target/release/pila ]; then
    echo "target/release/pila not found; build it first (cargo build --release)" >&2
    exit 1
fi

# The session entry runs the wrapper by its installed path.
desktop="$(mktemp)"
trap 'rm -f "$desktop"' EXIT
sed "s|@BINDIR@|$BINDIR|g" resources/session/pila.desktop >"$desktop"

for entry in "${install_files[@]}"; do
    IFS=: read -r source target mode <<<"$entry"
    [ "$source" = resources/session/pila.desktop ] && source="$desktop"
    target="$DESTDIR$target"
    # install unlinks the old file and creates a new one, so replacing the
    # binary of a running session is fine: it keeps its old inode.
    as_owner_of "$target" install -D -m "$mode" "$source" "$target"
    echo "installed $target"
done

echo
echo "Installed. Log out and pick \"pila\" in the login screen's session menu."
echo "Log: ~/.local/state/pila/pila.log (and journalctl -t pila -b with systemd)."
if [ "$DATADIR" = /usr/local/share ]; then
    echo "If the login screen doesn't list pila (LightDM and some SDDM setups only"
    echo "read /usr/share/wayland-sessions), uninstall and use PREFIX=/usr."
fi
