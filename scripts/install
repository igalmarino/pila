#!/usr/bin/env bash
# Install pila as a login session, on any distro and with any display manager
# that reads wayland-sessions (GDM, SDDM, LightDM, greetd front ends, ...):
# the release binary, the session wrapper, the session entry and its icon,
# the systemd user units the wrapper runs it as where there's systemd, and the
# portal configs for screen sharing. Run it from your desktop session; sudo
# asks once if the targets aren't writable. Afterwards log out and pick "pila"
# in the login screen's session menu. After changing pila: run it again, then
# log out and back in.
#
#   scripts/install              build the release binary, then install
#   scripts/install --container  build it in the dev container (scripts/dev)
#   scripts/install --no-build   install what's in target/release
#
# The build uses the host's cargo if there is one: a binary built in the dev
# container (Arch) needs Arch's glibc and libraries, which other distros may
# not have. Paths (PREFIX, SYSCONFDIR, DESTDIR, ...) are in
# scripts/install-paths; e.g. PREFIX=/usr scripts/install. Unless DESTDIR is
# set, it refuses to run in the dev container, checks that the binary runs
# here, and warns about another pila session entry in /usr or /usr/local.
#
# scripts/uninstall removes exactly these files (given the same variables).
# Your own config (~/.config/pila) and logs are left alone.
set -euo pipefail

cd "$(dirname "$0")/.."
source scripts/install-paths

build=auto
case "${1:-}" in
    "") ;;
    --container) build=container ;;
    --no-build) build=none ;;
    *) echo "usage: scripts/install [--container | --no-build]" >&2; exit 1 ;;
esac
# The session is installed on the host; inside the dev container it would only
# land in the container's own /usr/local. A staging install (DESTDIR) is fine.
if [ -n "${DEVCONTAINER:-}" ] && [ -z "$DESTDIR" ]; then
    echo "This is the dev container: run scripts/install on the host. Build here with" >&2
    echo "cargo build --release, then run scripts/install --no-build on the host." >&2
    exit 1
fi
if [ "$build" = auto ]; then
    if command -v cargo >/dev/null; then build=native; else build=container; fi
fi

# What the build needs from the system (docs/INSTALL.md, "Building"), checked
# before it starts: without it the build fails deep in a crate's build script
# (bindgen's panic for libclang). Each library: its pkg-config name, and what
# to install, named as distros package it.
build_libraries=(
    "libseat:libseat's development files (libseat, seatd, libseat-dev or libseat-devel)"
    "libinput:libinput's development files (libinput, libinput-dev or libinput-devel)"
    "libudev:libudev's development files (systemd-libs, libudev-dev, systemd-devel or eudev)"
    "gbm:gbm's development files (Mesa: mesa, libgbm-dev or mesa-libgbm-devel)"
    "xkbcommon:xkbcommon's development files (libxkbcommon, libxkbcommon-dev or libxkbcommon-devel)"
    "libpipewire-0.3:libpipewire's development files (libpipewire, libpipewire-0.3-dev or pipewire-devel)"
)

# Whether libclang can be loaded as bindgen loads it: from LIBCLANG_PATH when
# it's set, else from llvm-config's library directory, the linker's cache or
# the usual directories. libclang-cpp is another library.
have_libclang() {
    local dirs=()
    if [ -n "${LIBCLANG_PATH:-}" ]; then
        dirs=("$LIBCLANG_PATH")
    else
        if command -v llvm-config >/dev/null; then
            dirs+=("$(llvm-config --libdir 2>/dev/null)")
        fi
        if command -v ldconfig >/dev/null &&
            ldconfig -p 2>/dev/null | grep -Eq '[[:space:]]libclang(-[0-9][^[:space:]]*)?\.so'; then
            return 0
        fi
        dirs+=(/usr/lib /usr/lib64 /usr/local/lib /usr/lib/*-linux-gnu /usr/lib/llvm*/lib /usr/lib64/llvm*/lib)
    fi
    local dir file
    for dir in "${dirs[@]}"; do
        for file in "$dir"/libclang.so* "$dir"/libclang-[0-9]*.so*; do
            [ -e "$file" ] && return 0
        done
    done
    return 1
}

check_build_deps() {
    local missing=() entry name what
    if ! command -v pkg-config >/dev/null; then
        missing+=("pkg-config (pkg-config or pkgconf)")
    else
        for entry in "${build_libraries[@]}"; do
            IFS=: read -r name what <<<"$entry"
            pkg-config --exists "$name" || missing+=("$what")
        done
    fi
    have_libclang || missing+=("libclang (clang, libclang-dev or clang-devel)")
    [ ${#missing[@]} -eq 0 ] && return 0
    echo "Pila can't be built here yet. Missing:" >&2
    for what in "${missing[@]}"; do
        echo "  - $what" >&2
    done
    echo "Install them (each distro's package names are in docs/INSTALL.md, \"Building\")," >&2
    echo "then run scripts/install again. A libclang in another directory: set LIBCLANG_PATH to it." >&2
    exit 1
}

case "$build" in
    native)
        check_build_deps
        cargo build --release
        ;;
    container)
        if [ -z "${DEVCONTAINER:-}" ]; then
            echo "Building in the dev container: the binary is linked against Arch's" >&2
            echo "libraries and may not run on another distro (install Rust and build" >&2
            echo "on the host instead, see docs/INSTALL.md)." >&2
        fi
        scripts/dev cargo build --release
        ;;
esac
if [ ! -x target/release/pila ]; then
    echo "target/release/pila not found; build it first (cargo build --release)" >&2
    exit 1
fi

if [ -z "$DESTDIR" ]; then
    # A binary that can't load here (e.g. built in the dev container against a
    # newer glibc than the host's) would only fail at the next login.
    if ! error="$(target/release/pila --version 2>&1 >/dev/null)"; then
        echo "target/release/pila doesn't run on this system:" >&2
        echo "$error" >&2
        echo "Update the system's packages, or build Pila here (cargo build --release)." >&2
        exit 1
    fi
    # Another pila session entry under the other usual prefix (e.g. a distro
    # package in /usr next to this one in /usr/local) means two sessions with
    # the same name, and the display manager picks one of them.
    for other in /usr/share /usr/local/share; do
        entry="$other/wayland-sessions/pila.desktop"
        if [ "$other" != "$DATADIR" ] && [ -e "$entry" ]; then
            echo "warning: $entry exists too (another Pila install): the login screen" >&2
            echo "may start that one. Remove it: scripts/uninstall with its PREFIX, or" >&2
            echo "uninstall the package that owns it." >&2
        fi
    done
fi

# The session entry and pila.service run the wrapper by its installed path.
filled="$(mktemp -d)"
trap 'rm -rf "$filled"' EXIT
for file in pila.desktop pila.service; do
    sed "s|@BINDIR@|$BINDIR|g" "resources/session/$file" >"$filled/$file"
done

for entry in "${install_files[@]}"; do
    IFS=: read -r source target mode <<<"$entry"
    case "$source" in
        resources/session/pila.desktop | resources/session/pila.service)
            source="$filled/$(basename "$source")"
            ;;
    esac
    target="$DESTDIR$target"
    # install unlinks the old file and creates a new one, so replacing the
    # binary of a running session is fine: it keeps its old inode.
    as_owner_of "$target" install -D -m "$mode" "$source" "$target"
    echo "installed $target"
done
# Programs an older install put there that Pila no longer has.
for target in "${removed_files[@]}"; do
    target="$DESTDIR$target"
    if [ -e "$target" ]; then
        as_owner_of "$target" rm -f "$target"
        echo "removed  $target (no longer part of Pila)"
    fi
done

echo
echo "Installed. Log out and pick \"Pila\" in the login screen's session menu."
echo "Log: ~/.local/state/pila/pila.log (and journalctl -t pila -b with systemd)."
if [ "$DATADIR" = /usr/local/share ]; then
    echo "If the login screen doesn't list Pila (LightDM and some SDDM setups only"
    echo "read /usr/share/wayland-sessions), uninstall and use PREFIX=/usr."
fi
