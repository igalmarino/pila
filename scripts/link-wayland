#!/usr/bin/env bash
# Point the dev container at the Wayland session this runs from (GNOME, or
# pila on a TTY): hard-links that session's socket into a directory of its
# own, which the container mounts as /run/host-wayland (see devcontainer.json).
# Only that socket is shared, not the rest of $XDG_RUNTIME_DIR (D-Bus,
# PipeWire, ...). A hard link, not a symlink, because the container can't
# follow a link out of its mount. Run by devcontainer's initializeCommand and
# by scripts/dev before every command, so it follows the current session; a
# compositor that restarted makes a new socket, so run it again after that.
set -euo pipefail

: "${XDG_RUNTIME_DIR:?not set; run this from your desktop session}"
display="${WAYLAND_DISPLAY:-wayland-0}"
case "$display" in
    /*) socket="$display" ;;
    *) socket="$XDG_RUNTIME_DIR/$display" ;;
esac
if [ ! -S "$socket" ]; then
    echo "link-wayland: $socket is not a socket; is a Wayland session running?" >&2
    exit 1
fi

dir="$XDG_RUNTIME_DIR/pila-devcontainer"
mkdir -p "$dir"
chmod 700 "$dir"
ln -f "$socket" "$dir/wayland-0"
