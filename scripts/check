#!/usr/bin/env bash
# Bare-metal smoke and performance run: real programs (a terminal, xterm, a
# launcher, a bar, grim) drive a real pila (udev on a TTY, or nested)
# through windows opening and closing, minimize, maximize, workspace
# switches, a capture, a capture stream and a blurred window, while pila logs its frame
# statistics. The checks (PASS/FAIL, exit status 1 if any failed): the
# scenarios finished without a panic, animations ran, a bar's surfaces
# follow a layer rule, grim got a picture, the stream got frames, and the
# performance pillar holds (no missed refresh, CPU per frame on average within
# 4 ms, for the outputs' frames and the captures').
#
# Behavior is tested by the integration tests (`cargo test`, tests/*.rs);
# this run is for what they can't reach: the DRM/KMS backend, a real GPU,
# real clients and real frame times.
#
#   scripts/check               on bare metal: run it from a TTY on the host
#                               (Ctrl+Alt+F3, log in), through scripts/tty;
#                               the log is pila-tty.log
#   scripts/check --nested      nested, inside the current session (for
#                               development; the release build); the log is
#                               pila-check.log
#   scripts/check --vrr         on bare metal, with adaptive sync asked of
#                               every monitor: checks it comes on where the
#                               monitor can do it, Pila reports a variable
#                               refresh, and it's still on after powering the
#                               monitors off and on (wlopm). Missed refreshes
#                               count against vblanks that stretch to wait
#                               for frames: take those numbers from a run
#                               without it
#   scripts/check --judge <log> judge an existing log again (no run)
#   scripts/check [...] <config.toml>
#                               start from that config (see below)
#
# Installed (scripts/install and the packages) it's pila-check: it runs the
# pila next to it, without scripts/tty, finds its helpers (toplevel-action,
# workspace-action, capture-stream) in share/pila/check next to its bin
# directory, and logs to ~/.local/state/pila (XDG_STATE_HOME), so a tester
# needs no checkout.
#
# PILA_BIN runs another binary than target/release/pila (installed: the pila
# next to it), such as Nix's result/bin/pila.
# PILA_CHECK_RUST_LOG adds RUST_LOG directives to the run's own, to look into
# something the run shows, e.g. why direct scanout starts and stops:
#   PILA_CHECK_RUST_LOG=smithay::backend::drm::compositor=trace scripts/check
# PILA_CHECK_RENDER_LATE=false runs it with `render-late = false`, whatever the
# base config says, to compare the frames' latency with and without it.
#
# pila quits by itself when the scenarios are done (about a minute). On a
# TTY the base is your config (~/.config/pila/config.toml: monitors,
# keyboard, input) without its [animations], rules and workspaces, so that
# what the checks expect doesn't depend on them: animations on, their own
# rules, four workspaces.
# Nested there's no base. Programs it uses when installed: kitty or foot
# (needed), xterm, python3 (minimize, maximize, workspaces, the capture stream, the
# wallpaper's picture), swaybg (wallpaper), fuzzel (launcher), grim (capture), waybar
# (layer rule).
set -euo pipefail

# In a checkout (scripts/check) or installed (pila-check): see above.
self="$(readlink -f "$0")"
here="$(dirname "$self")"
if [ "$(basename "$here")" = scripts ]; then
    installed=false
    name=scripts/check
    helpers="$here"
    cd "$here/.."
    # Logs and the capture's picture go in the project root.
    out="$PWD"
else
    installed=true
    name=pila-check
    helpers="$(dirname "$here")/share/pila/check"
    out="${XDG_STATE_HOME:-$HOME/.local/state}/pila"
fi

# --- Inside pila (started with -c): the scenarios ----------------------------

if [ "${1:-}" = "--workload" ]; then
    # Written to pila's log (programs' output goes there): the analysis
    # below finds each scenario's events between these.
    mark() { echo "check: $*"; }

    # Quit pila (SIGTERM quits cleanly): the nearest pila among this
    # script's ancestors, never another one (the login session's). Nix's
    # package runs it as .pila-wrapped, behind a wrapper script.
    # The Pila running this, among the ancestors.
    pila_pid() {
        local pid=$PPID
        while [ "$pid" -gt 1 ]; do
            case "$(ps -o comm= -p "$pid")" in
                pila | .pila-wrapped)
                    echo "$pid"
                    return
                    ;;
            esac
            pid=$(ps -o ppid= -p "$pid" | tr -d ' ')
        done
        return 1
    }
    quit_pila() {
        local pid
        if pid=$(pila_pid); then
            kill -TERM "$pid"
        else
            mark "Pila not found among the ancestors; quit it with Mod+Shift+E"
        fi
    }
    # `pila msg ...` with the Pila running this.
    pila_msg() {
        local pid
        pid=$(pila_pid) && "$(readlink "/proc/$pid/exe")" msg "$@" >/dev/null
    }
    # A step that fails ends the scenarios (set -e): say which, and quit pila
    # all the same, or it would wait there until someone quits it.
    set -E
    failed_line=
    trap 'failed_line=$LINENO' ERR
    trap 'status=$?
        if [ "$status" -ne 0 ]; then
            mark "workload failed: line ${failed_line:-?} exited with $status"
        fi
        quit_pila' EXIT

    terminal="${PILA_CHECK_TERMINAL:-}"
    if [ -z "$terminal" ]; then
        for candidate in kitty foot; do
            if command -v "$candidate" >/dev/null; then
                terminal=$candidate
                break
            fi
        done
    fi
    # A terminal running `$@`.
    run_terminal() {
        case "$terminal" in
            # Without remember_window_size, a kitty opens at the size of
            # the last one closed (e.g. a maximized one), whatever pila
            # configures.
            kitty) "$terminal" --override remember_window_size=no "$@" ;;
            *) "$terminal" "$@" ;;
        esac
    }

    # Stop programs started in the background: a function run with `&`
    # (run_terminal) is a subshell, so its program is a child of `$!`.
    stop() {
        local pid
        for pid in "$@"; do
            pkill -TERM -P "$pid" 2>/dev/null || true
            kill "$pid" 2>/dev/null || true
        done
        wait "$@" 2>/dev/null || true
    }

    mark "terminal ${terminal:-none}"
    # A wallpaper under every frame, as most sessions have: swaybg on the
    # check's 4K gradient (`-c` replaces the base config's autostart).
    if [ -n "${PILA_CHECK_WALLPAPER:-}" ] && command -v swaybg >/dev/null; then
        swaybg -i "$PILA_CHECK_WALLPAPER" -m fill >/dev/null 2>&1 &
        mark "wallpaper swaybg"
    else
        mark "wallpaper skip (no swaybg or python3)"
    fi
    sleep 3
    if [ -z "$terminal" ]; then
        mark "no terminal (kitty or foot)"
    else
        mark "window begin"
        for _ in 1 2 3; do
            # Closes by itself when its program exits, as after `exit`.
            run_terminal sleep 1.5 || true
            sleep 1
        done
        mark "window end"

        if command -v grim >/dev/null; then
            mark "capture begin"
            run_terminal sleep 4 &
            held=$!
            sleep 2
            shot="$out/pila-check.png"
            rm -f "$shot"
            if grim "$shot" 2>&1 && [ -s "$shot" ]; then
                mark "capture ok"
            else
                mark "capture failed"
            fi
            stop "$held"
            sleep 1
            mark "capture end"
        else
            mark "capture skip (no grim)"
        fi

        # A capture stream, frame after frame as a screen share takes them
        # (the captures' frame budget), of a terminal whose clock changes
        # about every refresh.
        if command -v python3 >/dev/null; then
            mark "stream begin"
            run_terminal sh -c 'while :; do date +%T.%N; sleep 0.016; done' &
            ticker=$!
            sleep 2
            if got=$(python3 -I "$helpers/capture-stream" 4 2>&1); then
                mark "stream ok: $got"
            else
                mark "stream failed: $got"
            fi
            stop "$ticker"
            sleep 1
            mark "stream end"
        else
            mark "stream skip (no python3)"
        fi

        if command -v xterm >/dev/null; then
            mark "x11 begin"
            xterm -e sleep 1.5 || true
            sleep 1
            mark "x11 end"
        fi

        if command -v python3 >/dev/null; then
            mark "minimize begin"
            run_terminal sleep 60 &
            held=$!
            sleep 2
            for _ in 1 2; do
                python3 -I "$helpers/toplevel-action" min >/dev/null
                sleep 1
                python3 -I "$helpers/toplevel-action" unmin >/dev/null
                sleep 1
            done
            python3 -I "$helpers/toplevel-action" max >/dev/null
            sleep 1
            python3 -I "$helpers/toplevel-action" unmax >/dev/null
            sleep 1
            stop "$held"
            sleep 1
            mark "minimize end"

            mark "workspace begin"
            run_terminal sleep 8 &
            held=$!
            sleep 2
            python3 -I "$helpers/workspace-action" 2 >/dev/null
            sleep 1
            python3 -I "$helpers/workspace-action" 1 >/dev/null
            sleep 1
            # Twice in a row: the second slide starts from the first's frame.
            python3 -I "$helpers/workspace-action" 2 >/dev/null
            python3 -I "$helpers/workspace-action" 3 >/dev/null
            sleep 1
            python3 -I "$helpers/workspace-action" 1 >/dev/null
            sleep 1
            stop "$held"
            sleep 1
            mark "workspace end"
        fi

        # The overview over two terminals: every window glides into a
        # texture of its own, then shows live in it.
        if [ -n "$terminal" ]; then
            mark "overview begin"
            run_terminal sh -c 'while :; do date; done' &
            first=$!
            run_terminal sleep 10 &
            second=$!
            sleep 2
            for _ in 1 2; do
                pila_msg action overview open
                sleep 1.5
                pila_msg action overview close
                sleep 1
            done
            stop "$first" "$second"
            sleep 1
            mark "overview end"
        fi

        # A large blurred window over a terminal that never stops writing: its
        # backdrop is blurred anew all the time.
        case "$terminal" in
            kitty) glass=(kitty --override background_opacity=0.7 --class pila-check-glass) ;;
            # Foot says which of these two names of the setting it doesn't
            # know, and goes on.
            foot) glass=(foot --override colors.alpha=0.7 --override colors-dark.alpha=0.7
                --app-id=pila-check-glass) ;;
            *) glass=() ;;
        esac
        if [ "${#glass[@]}" -gt 0 ]; then
            mark "blur begin"
            run_terminal sh -c 'while :; do date; done' &
            behind=$!
            sleep 1
            "${glass[@]}" sleep 8 &
            held=$!
            sleep 3
            if command -v python3 >/dev/null; then
                python3 -I "$helpers/workspace-action" 2 >/dev/null
                sleep 1
                python3 -I "$helpers/workspace-action" 1 >/dev/null
                sleep 1
            fi
            sleep 1
            stop "$held" "$behind"
            sleep 1
            mark "blur end"
        else
            mark "blur skip (no kitty or foot)"
        fi

        # A fullscreen terminal that never stops writing: on bare metal its
        # frames can go to the screen as they are (direct scanout).
        if command -v python3 >/dev/null; then
            mark "fullscreen begin"
            run_terminal sh -c 'while :; do date; done' &
            held=$!
            sleep 2
            python3 -I "$helpers/toplevel-action" full >/dev/null
            sleep 3
            python3 -I "$helpers/toplevel-action" unfull >/dev/null
            sleep 1
            stop "$held"
            sleep 1
            mark "fullscreen end"
        fi

        # The same with a terminal that draws in shared memory (foot): its
        # whole-screen buffers are copied to the GPU at each commit, apart
        # from the frames (`upload.rs`, `uploads` in the frame statistics).
        if [ "$terminal" != foot ] && command -v foot >/dev/null; then
            mark "shm begin"
            foot --fullscreen sh -c 'while :; do date; done' &
            held=$!
            sleep 3
            stop "$held"
            sleep 1
            mark "shm end"
        else
            mark "shm skip (no foot, or it was the fullscreen terminal)"
        fi

        # A fullscreen game with vsync off: vkcube (package vulkan-tools) with
        # Vulkan's immediate present mode, for which Mesa asks for its frames
        # to tear (wp-tearing-control). On bare metal they go out with
        # asynchronous page flips (`tearing.rs`), if the driver takes them.
        if command -v vkcube >/dev/null && command -v python3 >/dev/null; then
            mark "tearing begin"
            vkcube --present_mode 0 >/dev/null 2>&1 &
            held=$!
            sleep 2
            python3 -I "$helpers/toplevel-action" full >/dev/null
            sleep 4
            stop "$held"
            sleep 1
            mark "tearing end"
        else
            mark "tearing skip (no vkcube)"
        fi
    fi

    if command -v fuzzel >/dev/null; then
        mark "layer begin"
        fuzzel &
        launcher=$!
        sleep 1
        stop "$launcher"
        sleep 1
        mark "layer end"
    fi

    # A bar's layer surfaces under a [[layer-rule]] that turns Pila's
    # animations off for them. Its own minimal config (a clock), so it
    # needs no other compositor's modules and no session bus; with no
    # exclusive zone, as a shell's panels, which Pila would animate.
    if command -v waybar >/dev/null; then
        mark "layer-rule begin"
        bar_dir=$(mktemp -d)
        printf '{ "layer": "top", "exclusive": false, "modules-right": ["clock"] }\n' >"$bar_dir/config.jsonc"
        printf '* { font-size: 13px; }\n' >"$bar_dir/style.css"
        waybar -c "$bar_dir/config.jsonc" -s "$bar_dir/style.css" >/dev/null 2>&1 &
        bar=$!
        sleep 3
        stop "$bar"
        rm -rf "$bar_dir"
        sleep 1
        mark "layer-rule end"
    else
        mark "layer-rule skip (waybar not installed)"
    fi

    # Adaptive sync (--vrr): still on after the monitors power off and on,
    # which sets their CRTCs up from scratch.
    if [ "${PILA_CHECK_VRR:-}" = 1 ]; then
        if ! command -v wlopm >/dev/null; then
            mark "vrr skip (wlopm not installed)"
        else
            mark "vrr begin"
            wlopm --off '*'
            sleep 2
            wlopm --on '*'
            sleep 2
            mark "vrr end"
        fi
    fi

    mark "done"
    sleep 1
    # The EXIT trap quits pila.
    exit 0
fi

# --- Outside: start pila, then judge its log ---------------------------------

usage="usage: $name [--nested | --vrr] [<config.toml>], $name --judge <log>"
case "${1:-}" in
    -h | --help)
        cat <<EOF
usage: $name [--nested | --vrr] [<config.toml>]
       $name --judge <log>

Runs Pila for about a minute with scripted scenarios (windows, minimize,
workspaces, captures, blur, fullscreen) and judges its log: PASS or FAIL per
check, with frame times (CPU, GPU) and, on bare metal, latency. Nothing to do
but wait; it quits by itself.

  (no option)  on bare metal: run it from a TTY (Ctrl+Alt+F3, log in), not
               from a graphical session, which can keep running on its VT;
               the base config is yours, without animations and rules
  --nested     in a window of the current session
  --vrr        on bare metal, with adaptive sync asked of every monitor
  --judge      judge an existing log again
  <config>     start from that config instead of yours

PILA_CHECK_RENDER_LATE=false runs it with render-late off, to compare the
frames' latency with and without it.

Its log: $out/pila-tty.log (bare metal) or pila-check.log (--nested).
EOF
        exit 0
        ;;
esac

judge_only=false
if [ "${1:-}" = "--judge" ]; then
    judge_only=true
    log=${2:?$usage}
fi
nested=false
if [ "${1:-}" = "--nested" ]; then
    nested=true
    shift
fi
vrr=false
if [ "${1:-}" = "--vrr" ]; then
    if $nested; then
        echo "--vrr needs bare metal: run it from a TTY, without --nested" >&2
        exit 2
    fi
    vrr=true
    shift
fi
if ! $judge_only; then
    base_config=${1:-}
    case "$base_config" in
        -*)
            echo "$name: no option $base_config; $usage" >&2
            exit 2
            ;;
    esac
    if [ ! -d "$helpers" ]; then
        echo "$name: its helper scripts aren't in $helpers; reinstall Pila" >&2
        exit 1
    fi
    if $installed; then
        bin="${PILA_BIN:-$here/pila}"
        if [ ! -x "$bin" ]; then
            echo "$bin not found; reinstall Pila, or set PILA_BIN" >&2
            exit 1
        fi
        if ! $nested; then
            # scripts/tty's checks, for a tester without a checkout.
            if [ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]; then
                echo "This looks like a graphical session; run $name from a TTY (e.g. Ctrl+Alt+F3)," >&2
                echo "or $name --nested for a run in a window." >&2
                exit 1
            fi
            if ! command -v dbus-run-session >/dev/null; then
                echo "dbus-run-session not found (package dbus, or dbus-daemon on some distros)" >&2
                exit 1
            fi
        fi
        mkdir -p "$out"
    fi

    work=$(mktemp -d)
    trap 'rm -rf "$work"' EXIT
    config="$work/config.toml"
    # On a TTY your own config is the base, for its monitors, keyboard and
    # input; nested, none. Its [animations] and rules are left out: the
    # checks expect animations on and only their own rules.
    if [ -z "$base_config" ] && ! $nested; then
        user_config="${XDG_CONFIG_HOME:-$HOME/.config}/pila/config.toml"
        if [ -f "$user_config" ]; then
            base_config=$user_config
        fi
    fi
    # The workload switches among workspaces 1 to 3: the count is the
    # check's, whatever the base config says (top-level keys come first).
    printf 'workspaces = 4\n' >"$config"
    case "${PILA_CHECK_RENDER_LATE:-}" in
        '') ;;
        true | false) printf 'render-late = %s\n' "$PILA_CHECK_RENDER_LATE" >>"$config" ;;
        *)
            echo "$name: PILA_CHECK_RENDER_LATE is true or false" >&2
            exit 2
            ;;
    esac
    if [ -n "$base_config" ]; then
        awk '/^[ \t]*\[/ { table = 1; skip = ($0 ~ /^[ \t]*\[(animations\]|\[window-rule\]\]|\[layer-rule\]\])/) }
             !table && /^[ \t]*(workspaces|render-late)[ \t]*=/ { next }
             !skip' "$base_config" >>"$config"
        echo "Base config: $base_config (without its [animations], rules and workspaces)."
    fi
    if $vrr; then
        # The first [[output]] that matches a monitor applies: each of yours
        # asks for adaptive sync, and so does one per connected connector
        # (DRM's names, as Pila's: card1-DP-1 is DP-1).
        awk '/^[ \t]*\[/ { out = ($0 ~ /^[ \t]*\[\[output\]\]/); print; if (out) print "adaptive-sync = true"; next }
             out && /^[ \t]*adaptive-sync[ \t]*=/ { next }
             { print }' "$config" >"$config.vrr" 2>/dev/null || true
        [ -f "$config.vrr" ] && mv "$config.vrr" "$config"
        for status in /sys/class/drm/card*-*/status; do
            [ "$(cat "$status" 2>/dev/null)" = connected ] || continue
            connector=$(basename "$(dirname "$status")")
            printf '\n[[output]]\nname = "%s"\nadaptive-sync = true\n' "${connector#*-}" >>"$config"
        done
        export PILA_CHECK_VRR=1
    fi
    # A 4K gradient for swaybg to draw under every frame (the workload).
    if command -v python3 >/dev/null; then
        python3 -I - "$work/wallpaper.png" <<'PNG'
import struct, sys, zlib
width, height = 3840, 2160
rows = b"".join(b"\0" + bytes(b for x in range(width) for b in (x * 255 // width, y * 255 // height, 140))
                for y in range(height))
def chunk(kind, data):
    return struct.pack(">I", len(data)) + kind + data + struct.pack(">I", zlib.crc32(kind + data))
with open(sys.argv[1], "wb") as f:
    f.write(b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0))
            + chunk(b"IDAT", zlib.compress(rows, 1)) + chunk(b"IEND", b""))
PNG
        export PILA_CHECK_WALLPAPER="$work/wallpaper.png"
    fi
    cat >>"$config" <<EOF

    # Added by scripts/check.
    [[layer-rule]]
    namespace = "waybar"
    animations = false

    [[window-rule]]
    app-id = "pila-check-glass"
    size = [1000, 700]
    blur = true
EOF
    export PILA_CHECK_CONFIG="$config"
    # Where pila's log goes (absolute: the workload runs elsewhere).
    if $nested; then
        log="$out/pila-check.log"
    else
        log="$out/pila-tty.log"
    fi
    export PILA_CHECK_LOG="$log"
    export RUST_LOG="info,pila::frames=debug,pila::animation=debug,pila::rules=debug,pila::blur=debug${PILA_CHECK_RUST_LOG:+,$PILA_CHECK_RUST_LOG}"

    if [ -n "${PILA_CHECK_RUST_LOG:-}" ]; then
        echo "Log filter: $RUST_LOG"
    fi
    echo "Runs Pila with scripted scenarios for about a minute; it quits by itself."
    echo "Nothing to do but wait (to stop early: Mod+Shift+E)."
    workload="$(printf '%q' "$self") --workload"
    if $nested; then
        if ! $installed; then
            bin="${PILA_BIN:-target/release/pila}"
            if [ ! -x "$bin" ]; then
                echo "$bin not found; build it first: cargo build --release, or set PILA_BIN" >&2
                exit 1
            fi
            # A build older than the sources would test old code without
            # saying so. A binary given by hand isn't this checkout's.
            if [ -z "${PILA_BIN:-}" ]; then
                newer="$(find src build.rs Cargo.toml Cargo.lock -newer "$bin" -type f -print -quit 2>/dev/null || true)"
                if [ -n "$newer" ]; then
                    echo "$bin is older than the sources (e.g. $newer); rebuild it: cargo build --release" >&2
                    exit 1
                fi
            fi
        fi
        timeout 300 "$bin" --config "$config" -c "$workload" 2>"$log" || true
    elif $installed; then
        # As scripts/tty runs it: its own D-Bus session bus, the last log kept.
        [ -f "$log" ] && mv -f "$log" "$log.old"
        echo "Starting $bin; log in $log."
        dbus-run-session -- "$bin" --backend udev --config "$config" -c "$workload" 2>"$log" || true
    else
        scripts/tty "$config" -- -c "$workload" || true
    fi
fi

# --- Judging -------------------------------------------------------------

failed=0
pass() { printf 'PASS  %s\n' "$*"; }
info() { printf 'INFO  %s\n' "$*"; }
fail() {
    printf 'FAIL  %s\n' "$*"
    failed=1
}
skip() { printf 'SKIP  %s\n' "$*"; }

# The log lines of scenario $1 (between its marks).
section() {
    awk -v name="$1" '
        $0 ~ "check: " name " begin" { on = 1; next }
        $0 ~ "check: " name " end" { on = 0 }
        on' "$log"
}
# Whether scenario $1 ran (else it was skipped, and why).
ran() {
    if grep -q "check: $1 begin" "$log"; then
        return 0
    fi
    local why
    why=$(grep -o "check: $1 skip.*" "$log" | sed "s/check: $1 skip //" || true)
    skip "$1 ${why:-(did not run)}"
    return 1
}
# Check that the section has (or, with !, lacks) an event.
has() {
    local text=$1 label=$2 pattern=$3
    if grep -q -- "$pattern" <<<"$text"; then
        pass "$label"
    else
        fail "$label (no '$pattern' in the log)"
    fi
}
lacks() {
    local text=$1 label=$2 pattern=$3
    if grep -q -- "$pattern" <<<"$text"; then
        fail "$label (found '$pattern')"
    else
        pass "$label"
    fi
}

echo
echo "== Checks ($log) =="
if ! grep -q "check: done" "$log"; then
    why=$(grep -o "check: workload failed.*" "$log" | sed 's/check: //' | head -1 || true)
    fail "the scenarios finished (${why:-Pila quit or crashed before}; see the log)"
fi
if grep -q "panicked" "$log"; then
    fail "no panic"
fi

terminal=$(grep -o 'check: terminal [a-z]*' "$log" | head -1 | awk '{print $3}' || true)
if [ "${terminal:-none}" = none ]; then
    fail "a terminal ran the window scenarios (install kitty or foot)"
fi
# Without animations the frame statistics below have little to judge: missed
# refreshes count while one runs (and, on bare metal, frames shown late).
n=$(grep -c 'starts what="' "$log" || true)
[ "$n" -gt 0 ] && pass "animations ran ($n)" || fail "animations ran (none started)"
if grep -q 'check: wallpaper swaybg' "$log"; then
    if grep -q 'layer rules namespace="wallpaper"' "$log"; then
        pass "swaybg draws a wallpaper under every frame"
    else
        fail "swaybg draws a wallpaper under every frame (no layer surface of its own)"
    fi
fi
if ran capture; then
    s=$(section capture)
    has "$s" "grim captures the screen" "check: capture ok"
fi
if ran stream; then
    s=$(section stream)
    has "$s" "a capture stream gets frames as the screen changes" "check: stream ok"
fi
if ran blur; then
    s=$(section blur)
    has "$s" "a window rule gives a translucent window a backdrop" "blur: allocated"
fi
if ran overview; then
    s=$(section overview)
    has "$s" "the overview glides open and closed" 'starts what="overview" id="close"'
fi
if ran layer-rule; then
    s=$(section layer-rule)
    has "$s" "waybar's surfaces match the waybar rule" 'layer rules namespace="waybar"'
    has "$s" "the rule turns Pila's animations off for them" 'off by rule what="layer-in" id="waybar"'
    lacks "$s" "Pila doesn't animate any of them" 'starts what="layer-[a-z]*" id="waybar"'
fi

# Adaptive sync (--vrr; `udev/outputs.rs`, `udev/draw.rs`): on where a monitor
# can do it, reported to clients, and still on after powering off and on.
if grep -q 'check: vrr' "$log" && ran vrr; then
    on=$(grep -o 'adaptive sync set name="[^"]*" on=true' "$log" | cut -d'"' -f2 | sort -u || true)
    if [ -z "$on" ]; then
        skip "vrr (no monitor took adaptive sync: none can do it, or it's off in their own menu)"
    else
        s=$(section vrr)
        for name in $on; do
            has "$(cat "$log")" "$name reports a variable refresh with adaptive sync on" \
                "refresh reported to clients name=\"$name\" variable=true"
            has "$s" "$name keeps adaptive sync after powering off and on" \
                "refresh reported to clients name=\"$name\" variable=true"
        done
    fi
    unable=$(grep -o 'adaptive sync not supported by the monitor name="[^"]*"' "$log" | cut -d'"' -f2 | sort -u || true)
    for name in $unable; do
        info "vrr: $name can't do adaptive sync"
    done
fi

# Frame statistics, over the whole run (the performance pillar).
stats=$(grep 'pila::frames: frames' "$log" || true)
if [ -z "$stats" ]; then
    fail "frame statistics were logged"
else
    # A field older logs lack (`late`) sums to 0.
    # A whole field: `frames=` isn't `gpu_frames=`.
    sum() { { grep -oE "(^| )$1=[0-9]*" <<<"$stats" || true; } | cut -d= -f2 | awk '{ s += $1 } END { print s + 0 }'; }
    missed=$(sum missed)
    late=$(sum late)
    frames=$(sum frames)
    worst_avg=$(grep -o 'cpu_avg_ms=[0-9.]*' <<<"$stats" | cut -d= -f2 | sort -g | tail -1)
    worst=$(grep -o 'cpu_max_ms=[0-9.]*' <<<"$stats" | cut -d= -f2 | sort -g | tail -1)
    [ "$missed" -eq 0 ] && pass "no refresh missed ($frames frames)" ||
        fail "no refresh missed ($missed missed in $frames frames; $late frames shown late)"
    if awk -v v="$worst_avg" 'BEGIN { exit !(v <= 4) }'; then
        pass "CPU per frame on average within 4 ms (worst average ${worst_avg} ms; worst frame ${worst} ms)"
    else
        fail "CPU per frame on average within 4 ms (worst average ${worst_avg} ms)"
    fi
fi

# Redraws that found nothing new on an output (`idle` in the frame statistics:
# a commit with no new picture, the pointer moving with no cursor drawn) queue no
# frame; on bare metal at most one per refresh (`udev/draw.rs::idle_wait`).
# Reported per output, not judged.
if [ -n "$stats" ]; then
    awk '{
        o = ""; n = c = t = 0
        for (i = 1; i <= NF; i++) {
            if ($i ~ /^output=/) { o = substr($i, 8); gsub(/"/, "", o) }
            if ($i ~ /^idle=/) n = substr($i, 6)
            if ($i ~ /^idle_cpu_ms=/) c = substr($i, 13)
            if ($i ~ /^secs=/) t = substr($i, 6)
        }
        idle[o] += n; cpu[o] += c; secs[o] += t
    } END {
        for (o in idle) if (idle[o] > 0)
            printf "%s %d %.1f %.1f\n", o, idle[o], cpu[o], secs[o] ? idle[o] / secs[o] : 0
    }' <<<"$stats" | while read -r output count cpu rate; do
        info "redraws with nothing new on $output: $count (${rate}/s), ${cpu} ms of CPU in all"
    done
fi

# The GPU's part of each frame (`gpu_frames`, `gpu_avg_ms`, `gpu_max_ms` in the
# frame statistics: from its submission to the GPU finishing it, by its native
# fence; `frame_stats.rs`), per output: on top of the CPU time, what a frame
# needs to be ready for its vblank. Reported, not judged (no budget yet).
if [ -n "$stats" ]; then
    gpu=$(awk '{
        o = ""; n = a = m = 0
        for (i = 1; i <= NF; i++) {
            if ($i ~ /^output=/) { o = substr($i, 8); gsub(/"/, "", o) }
            if ($i ~ /^gpu_frames=/) n = substr($i, 12)
            if ($i ~ /^gpu_avg_ms=/) a = substr($i, 12)
            if ($i ~ /^gpu_max_ms=/) m = substr($i, 12) + 0
        }
        count[o] += n; total[o] += n * a; if (m > worst[o]) worst[o] = m
    } END {
        for (o in count) if (count[o] > 0)
            printf "%s %d %.2f %.2f\n", o, count[o], total[o] / count[o], worst[o]
    }' <<<"$stats")
    if [ -n "$gpu" ]; then
        while read -r output count average worst; do
            info "GPU per frame on $output: ${average} ms on average, worst ${worst} ms ($count frames timed)"
        done <<<"$gpu"
    elif grep -q 'GPU time not measured' "$log"; then
        info "GPU time not measured: frames came with no native fence (software rendering gives none)"
    fi
fi

# The frames' latency on bare metal (`latency_*` in the frame statistics: from
# the first redraw asked for with something new to the vblank that showed it),
# and how many frames were held to be drawn close to their vblank (`held`:
# `render-late`, `udev/render_late.rs`), how far before it (`margin_*`) and
# how long before it they were ready (`spare_*`: what the margin left; the
# least of it says how much the margin could shrink), per output. Reported,
# not judged: it depends on what the scenarios ask for when; compare runs with
# PILA_CHECK_RENDER_LATE=false.
if [ -n "$stats" ] && grep -q 'backend=Udev' "$log"; then
    awk '{
        o = ""; f = h = n = a = m = ma = mm = sn = sa = 0; sm = -1
        for (i = 1; i <= NF; i++) {
            if ($i ~ /^output=/) { o = substr($i, 8); gsub(/"/, "", o) }
            if ($i ~ /^frames=/) f = substr($i, 8)
            if ($i ~ /^held=/) h = substr($i, 6)
            if ($i ~ /^latency_frames=/) n = substr($i, 16)
            if ($i ~ /^latency_avg_ms=/) a = substr($i, 16)
            if ($i ~ /^latency_max_ms=/) m = substr($i, 16) + 0
            if ($i ~ /^margin_avg_ms=/) ma = substr($i, 15)
            if ($i ~ /^margin_max_ms=/) mm = substr($i, 15) + 0
            if ($i ~ /^spare_frames=/) sn = substr($i, 14)
            if ($i ~ /^spare_avg_ms=/) sa = substr($i, 14)
            if ($i ~ /^spare_min_ms=/) sm = substr($i, 14) + 0
        }
        frames[o] += f; held[o] += h; count[o] += n; total[o] += n * a
        if (m > worst[o]) worst[o] = m
        margin[o] += h * ma; if (mm > mworst[o]) mworst[o] = mm
        spares[o] += sn; spare[o] += sn * sa
        if (sn > 0 && (!(o in sleast) || sm < sleast[o])) sleast[o] = sm
    } END {
        for (o in count) if (count[o] > 0)
            printf "%s %d %.2f %.2f %d %d %.2f %.2f %d %.2f %.2f\n", o, count[o], total[o] / count[o], worst[o], held[o], frames[o],
                held[o] ? margin[o] / held[o] : 0, mworst[o], spares[o], spares[o] ? spare[o] / spares[o] : 0, (o in sleast) ? sleast[o] : 0
    }' <<<"$stats" | while read -r output count average worst held frames margin mworst spares spare sleast; do
        info "latency on $output: ${average} ms on average, worst ${worst} ms ($count frames); $held of $frames frames held to render late"
        if [ "$spares" -gt 0 ]; then
            info "render late on $output: drawn ${margin} ms before the vblank on average (at most ${mworst}); ready ${spare} ms before it on average, ${sleast} ms at least ($spares frames)"
        fi
    done
    backoffs=$(grep -c 'render late: a held frame came late' "$log" || true)
    if [ "$backoffs" -gt 0 ]; then
        info "render late backed off $backoffs times (a held frame came late)"
    fi
fi

# The event loop's own work after each iteration (`loop` in the frame
# statistics: `Pila::after_frames`, captures apart), paced by input and clients
# rather than by frames. Reported, not judged.
loops=$(grep 'pila::frames: loop' "$log" || true)
if [ -n "$loops" ]; then
    read -r iterations housekeeping cpu worst rate < <(awk '{
        for (i = 1; i <= NF; i++) {
            if ($i ~ /^iterations=/) n += substr($i, 12)
            if ($i ~ /^housekeeping=/) h += substr($i, 14)
            if ($i ~ /^cpu_ms=/) c += substr($i, 8)
            if ($i ~ /^cpu_max_ms=/) { m = substr($i, 12) + 0; if (m > w) w = m }
            if ($i ~ /^secs=/) t += substr($i, 6)
        }
    } END { printf "%d %d %.1f %.2f %.0f\n", n, h, c, w, t ? h / t : 0 }' <<<"$loops")
    info "event loop: $iterations iterations, $housekeeping with all the housekeeping (${rate}/s), ${cpu} ms of CPU in all, worst ${worst} ms"
fi

# Clients' shm buffers copied to the GPU at their commits, apart from the
# frames (`uploads` in the frame statistics, `upload.rs`). A copy holds the
# event loop, and a frame due meanwhile, so each stays within half a period at
# 60 Hz, the margin a frame held to render late is drawn with: a whole buffer
# copied at once took the driver's slow path (a fullscreen foot's first
# 1920x1080 buffer, 22.5 ms on bare metal, a refresh missed), which Smithay's
# upload in strips (Pila's fork) avoids; a new buffer's first copy still
# costs a few ms (the driver's upload path starting cold).
uploads=$(grep 'pila::frames: uploads' "$log" || true)
if [ -n "$uploads" ]; then
    read -r count average worst < <(awk '{
        u = c = 0
        for (i = 1; i <= NF; i++) {
            if ($i ~ /^uploads=/) u = substr($i, 9)
            if ($i ~ /^cpu_avg_ms=/) c = substr($i, 12)
            if ($i ~ /^cpu_max_ms=/) { m = substr($i, 12) + 0; if (m > w) w = m }
        }
        n += u; s += u * c
    } END { printf "%d %.2f %.2f\n", n, n ? s / n : 0, w }' <<<"$uploads")
    if awk -v v="$worst" 'BEGIN { exit !(v <= 8) }'; then
        pass "clients' shm buffers copied at their commits within 8 ms each ($count, ${average} ms of CPU on average, worst ${worst} ms)"
    else
        fail "clients' shm buffers copied at their commits within 8 ms each ($count, worst ${worst} ms)"
    fi
fi

# Captures' copies into shm, finished once the GPU is done (`copies` in the
# frame statistics: the read-back written into the capture client's buffer,
# or a portal share's). Like an upload, a copy holds the event loop and a
# frame due meanwhile: each within half a period at 60 Hz.
copies=$(grep 'pila::frames: copies' "$log" || true)
if [ -n "$copies" ]; then
    read -r count average worst < <(awk '{
        u = c = 0
        for (i = 1; i <= NF; i++) {
            if ($i ~ /^copies=/) u = substr($i, 8)
            if ($i ~ /^cpu_avg_ms=/) c = substr($i, 12)
            if ($i ~ /^cpu_max_ms=/) { m = substr($i, 12) + 0; if (m > w) w = m }
        }
        n += u; s += u * c
    } END { printf "%d %.2f %.2f\n", n, n ? s / n : 0, w }' <<<"$copies")
    if awk -v v="$worst" 'BEGIN { exit !(v <= 8) }'; then
        pass "captures copied into shm once the GPU was done within 8 ms each ($count, ${average} ms of CPU on average, worst ${worst} ms)"
    else
        fail "captures copied into shm once the GPU was done within 8 ms each ($count, worst ${worst} ms)"
    fi
fi

# Frames that were an app's buffer as it is (direct scanout, bare metal:
# `direct` in the frame statistics; `udev/draw.rs::frame_flags`), which the
# fullscreen scenario may bring: it depends on the terminal (an opaque buffer
# from the GPU) and on what a shell keeps above it. Reported, not judged.
if [ -n "$stats" ] && grep -q 'backend=Udev' "$log"; then
    direct=$(sum direct)
    if [ "$direct" -gt 0 ]; then
        info "frames shown straight from an app's buffer (direct scanout): $direct of $frames"
    elif grep -q 'check: fullscreen begin' "$log"; then
        info "no frame shown straight from an app's buffer (direct scanout), fullscreen terminal included"
    fi
fi

# Monitors on another GPU (`other-gpus`, `udev/secondary.rs`) are drawn on the
# primary and copied over: through a buffer both GPUs share or, when none can
# be shared, through memory (Smithay logs "Falling back to cpu-copy"), which a large
# monitor can't afford at its refresh rate. The copy's CPU time is in those
# outputs' frame statistics; the way it went is reported, not judged.
if grep -q 'using another GPU for its monitors' "$log"; then
    if grep -q 'Falling back to cpu-copy' "$log"; then
        info "monitors on another GPU: their frames copied through memory (no buffer could be shared between the GPUs)"
    else
        info "monitors on another GPU: their frames copied between the GPUs (no copy through memory logged)"
    fi
fi

# Frames shown at once, torn (`tearing` in the frame statistics: bare metal),
# which the vkcube scenario brings where the driver takes asynchronous page
# flips. Reported, not judged.
if [ -n "$stats" ] && grep -q 'backend=Udev' "$log" && grep -q 'check: tearing begin' "$log"; then
    torn=$(sum torn)
    if [ "$torn" -gt 0 ]; then
        info "frames torn (shown at once: a fullscreen game with vsync off): $torn"
    else
        info "no frame torn: the driver refused asynchronous page flips, or vkcube didn't ask"
    fi
fi

# The first frame after an output is set up (swapchain, modeset) is a cost of
# setting it up, logged apart from the budget (`udev/draw.rs`).
setups=$(grep -o 'first frame after setting the output up output="[^"]*" cpu_ms=[0-9.]*' "$log" |
    sed 's/.*cpu_ms=//' || true)
if [ -n "$setups" ]; then
    info "outputs set up: $(wc -l <<<"$setups") first frames, worst $(sort -g <<<"$setups" | tail -1) ms (not in the frame budget)"
fi

# Screen captures build their frames on top of the outputs' (`frame_stats.rs`),
# held to the same budget, on average over all of them: a lone first frame
# (grim's, a texture to allocate) doesn't stand for a share.
captures=$(grep 'pila::frames: captures' "$log" || true)
if [ -n "$captures" ]; then
    read -r passes average < <(awk '{
        p = c = 0
        for (i = 1; i <= NF; i++) {
            if ($i ~ /^passes=/) p = substr($i, 8)
            if ($i ~ /^cpu_avg_ms=/) c = substr($i, 12)
        }
        n += p; s += p * c
    } END { printf "%d %.2f\n", n, n ? s / n : 0 }' <<<"$captures")
    worst=$(grep -o 'cpu_max_ms=[0-9.]*' <<<"$captures" | cut -d= -f2 | sort -g | tail -1)
    if awk -v v="$average" 'BEGIN { exit !(v <= 4) }'; then
        pass "captures' CPU per frame on average within 4 ms ($passes frames, ${average} ms; worst frame ${worst} ms)"
    else
        fail "captures' CPU per frame on average within 4 ms ($passes frames, ${average} ms)"
    fi
fi

# Gamma (`udev/gamma.rs`; bare metal, if a night light set it): a client's
# changes go out as commits that don't wait; the blocking ioctl is left for
# after a modeset and for drivers without GAMMA_LUT.
gamma_ms() {
    grep -o "pila::frames: gamma ms=[0-9.]* how=\"$1\"" "$log" | sed 's/.*ms=\([0-9.]*\).*/\1/' || true
}
commits=$(gamma_ms commit)
if [ -n "$commits" ]; then
    worst=$(sort -g <<<"$commits" | tail -1)
    if awk -v v="$worst" 'BEGIN { exit !(v <= 4) }'; then
        pass "gamma changes don't block ($(wc -l <<<"$commits"), worst ${worst} ms)"
    else
        fail "gamma changes don't block (worst ${worst} ms)"
    fi
fi
ioctls=$(gamma_ms ioctl)
if [ -n "$ioctls" ]; then
    info "gamma set the blocking way: $(wc -l <<<"$ioctls") times, worst $(sort -g <<<"$ioctls" | tail -1) ms (after a modeset, or no GAMMA_LUT)"
fi

# Bare metal only: nothing else reads an EDID (`edid.rs`).
if grep -q 'backend=Udev' "$log"; then
    monitors=$(grep -cE 'pila::udev(::[a-z_]+)?: monitor ' "$log" || true)
    if [ "$monitors" -eq 0 ]; then
        fail "monitors were identified (none logged)"
    elif grep -E 'pila::udev(::[a-z_]+)?: monitor ' "$log" | grep -q 'make="Unknown"'; then
        fail "monitors were identified (one has no valid EDID)"
    else
        pass "monitors were identified ($monitors)"
    fi
fi

echo
if [ "$failed" -eq 0 ]; then
    echo "All checks passed."
else
    echo "Some checks failed; the log is $log."
fi
exit "$failed"
