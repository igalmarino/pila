#!/usr/bin/env bash
# Run pila on bare metal from a TTY on the host (Ctrl+Alt+F3, log in, run
# this). The binary is the one built in the dev container (scripts/dev cargo
# build); the log goes to pila-tty.log in the project root.
#
#   scripts/tty                 use scripts/tty-test.toml
#   scripts/tty <config.toml>   use another config
set -euo pipefail

cd "$(dirname "$0")/.."

bin=target/debug/pila
config="${1:-scripts/tty-test.toml}"

if [ ! -x "$bin" ]; then
    echo "$bin not found; build it first: scripts/dev cargo build" >&2
    exit 1
fi
if [ ! -f "$config" ]; then
    echo "config $config not found" >&2
    exit 1
fi
if [ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]; then
    echo "This looks like a graphical session; run it from a TTY (e.g. Ctrl+Alt+F3)." >&2
    exit 1
fi

echo "Starting pila with $config; log in pila-tty.log. Quit with Mod+Shift+E."
exec "$bin" --backend udev --config "$config" 2>pila-tty.log
