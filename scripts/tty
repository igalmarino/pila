#!/usr/bin/env bash
# Run pila by hand from a TTY on the host (Ctrl+Alt+F3, log in, run this):
# the way to try a build or a config on a spare VT while your pila login
# session (scripts/install) keeps running on another. The binary is the one
# built in the dev container (scripts/dev cargo build --release; it asks
# before running a build older than the sources); the log goes
# to pila-tty.log in the project root, and the previous run's to
# pila-tty.log.old.
#
# This pila gets its own D-Bus session bus (dbus-run-session), so the portals
# it starts for screen sharing (xdg-desktop-portal + xdg-desktop-portal-wlr)
# are its own and the login session's services are left alone. They find
# resources/xdg/xdg-desktop-portal/pila-portals.conf through XDG_CONFIG_DIRS;
# xdg-desktop-portal-wlr's settings are copied to ~/.config if missing.
#
#   scripts/tty                        release build, ~/.config/pila/config.toml
#   scripts/tty <config.toml>          another config
#   scripts/tty --debug [config.toml]  the debug build (scripts/dev cargo build)
set -euo pipefail

cd "$(dirname "$0")/.."

bin=target/release/pila
build="scripts/dev cargo build --release"
if [ "${1:-}" = "--debug" ]; then
    bin=target/debug/pila
    build="scripts/dev cargo build"
    shift
fi
config_args=()
if [ $# -gt 0 ]; then
    if [ ! -f "$1" ]; then
        echo "config $1 not found" >&2
        exit 1
    fi
    config_args=(--config "$1")
fi

if [ ! -x "$bin" ]; then
    echo "$bin not found; build it first: $build" >&2
    exit 1
fi
# A build older than the sources would test old code without saying so.
newer="$(find src build.rs Cargo.toml Cargo.lock -newer "$bin" -type f -print -quit 2>/dev/null)"
if [ -n "$newer" ]; then
    echo "$bin is older than the sources (e.g. $newer); rebuild it: $build" >&2
    if [ -t 0 ]; then
        read -r -p "Run the old build anyway? [y/N] " answer
        case "$answer" in
            y | Y | yes) ;;
            *) exit 1 ;;
        esac
    fi
fi
if [ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]; then
    echo "This looks like a graphical session; run it from a TTY (e.g. Ctrl+Alt+F3)." >&2
    exit 1
fi
if ! command -v dbus-run-session >/dev/null; then
    echo "dbus-run-session not found (package dbus, or dbus-daemon on some distros)" >&2
    exit 1
fi

export XDG_CONFIG_DIRS="$PWD/resources/xdg:${XDG_CONFIG_DIRS:-/etc/xdg}"

# xdg-desktop-portal-wlr only looks in ~/.config (or /etc/xdg) for its config.
xdpw_config="${XDG_CONFIG_HOME:-$HOME/.config}/xdg-desktop-portal-wlr/pila"
if [ ! -e "$xdpw_config" ]; then
    mkdir -p "$(dirname "$xdpw_config")"
    cp resources/xdg/xdg-desktop-portal-wlr/pila "$xdpw_config"
    echo "Installed $xdpw_config (screen sharing picks a screen with slurp)."
fi

# Keep the last run's log: after a crash, it's the one that matters.
[ -f pila-tty.log ] && mv -f pila-tty.log pila-tty.log.old

echo "Starting $bin ${config_args[*]:-}; log in pila-tty.log. Quit with Mod+Shift+E."
exec dbus-run-session -- "$bin" --backend udev "${config_args[@]}" 2>pila-tty.log
