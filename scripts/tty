#!/usr/bin/env bash
# Run pila by hand from a TTY on the host (Ctrl+Alt+F3, log in, run this):
# the way to try a build or a config on a spare VT while your pila login
# session (scripts/install) keeps running on another. The binary is the one
# built in the dev container (scripts/dev cargo build --release; it asks
# before running a build older than the sources); the log goes
# to pila-tty.log in the project root, and the previous run's to
# pila-tty.log.old.
#
# This pila gets its own D-Bus session bus (dbus-run-session), so the portals
# it starts (xdg-desktop-portal and its backends) are its own and the login
# session's services are left alone. They find Pila's own backend (screen
# sharing and screenshots, resources/portals/pila.portal) next to the
# installed ones, and resources/xdg/xdg-desktop-portal/pila-portals.conf,
# through XDG_DESKTOP_PORTAL_DIR, a directory made for the run.
#
#   scripts/tty                        release build, ~/.config/pila/config.toml
#   scripts/tty <config.toml>          another config
#   scripts/tty --debug [config.toml]  the debug build (scripts/dev cargo build)
#   scripts/tty [...] -- <pila args>   pass arguments on to pila (e.g. -c CMD)
#   PILA_BIN=<path> scripts/tty [...]  another binary, such as an installed one
set -euo pipefail

cd "$(dirname "$0")/.."

bin=target/release/pila
build="scripts/dev cargo build --release"
if [ "${1:-}" = "--debug" ]; then
    bin=target/debug/pila
    build="scripts/dev cargo build"
    shift
fi
config_args=()
if [ $# -gt 0 ] && [ "$1" != "--" ]; then
    if [ ! -f "$1" ]; then
        echo "config $1 not found" >&2
        exit 1
    fi
    config_args=(--config "$1")
    shift
fi
pila_args=()
if [ "${1:-}" = "--" ]; then
    shift
    pila_args=("$@")
fi

bin="${PILA_BIN:-$bin}"
if [ ! -x "$bin" ]; then
    echo "$bin not found; build it first: $build, or set PILA_BIN" >&2
    exit 1
fi
# A build older than the sources would test old code without saying so. A binary
# given by hand isn't this checkout's.
newer=""
if [ -z "${PILA_BIN:-}" ]; then
    newer="$(find src build.rs Cargo.toml Cargo.lock -newer "$bin" -type f -print -quit 2>/dev/null || true)"
fi
if [ -n "$newer" ]; then
    echo "$bin is older than the sources (e.g. $newer); rebuild it: $build" >&2
    if [ -t 0 ]; then
        read -r -p "Run the old build anyway? [y/N] " answer
        case "$answer" in
            y | Y | yes) ;;
            *) exit 1 ;;
        esac
    fi
fi
if [ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]; then
    echo "This looks like a graphical session; run it from a TTY (e.g. Ctrl+Alt+F3)." >&2
    exit 1
fi
if ! command -v dbus-run-session >/dev/null; then
    echo "dbus-run-session not found (package dbus, or dbus-daemon on some distros)" >&2
    exit 1
fi

# xdg-desktop-portal reads its backends from one directory: the installed ones
# (each data directory's) and Pila's own, together in one made for this run.
# Given that directory, it reads its configuration from there alone too.
# A new one each run: an earlier run's may not be ours to clear (one run
# with sudo leaves it root's), and those that are go.
runtime="${XDG_RUNTIME_DIR:-/tmp}"
rm -rf "$runtime"/pila-tty-portals "$runtime"/pila-tty-portals.* 2>/dev/null || true
portal_dir="$(mktemp -d "$runtime/pila-tty-portals.XXXXXX")"
# The checkout's own first: an installed Pila's pila.portal is among the
# system's, and linked first it had the copy written through the link.
cp resources/portals/pila.portal resources/xdg/xdg-desktop-portal/pila-portals.conf "$portal_dir/"
IFS=: read -r -a data_dirs <<<"${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
for dir in "${data_dirs[@]}"; do
    for portal in "$dir"/xdg-desktop-portal/portals/*.portal; do
        if [ -e "$portal" ] && [ ! -e "$portal_dir/$(basename "$portal")" ]; then
            ln -s "$portal" "$portal_dir/"
        fi
    done
done
export XDG_DESKTOP_PORTAL_DIR="$portal_dir"

# Keep the last run's log: after a crash, it's the one that matters.
[ -f pila-tty.log ] && mv -f pila-tty.log pila-tty.log.old

echo "Starting $bin ${config_args[*]:-} ${pila_args[*]:-}; log in pila-tty.log. Quit with Mod+Shift+E."
exec dbus-run-session -- "$bin" --backend udev "${config_args[@]}" "${pila_args[@]}" 2>pila-tty.log
