#!/usr/bin/env bash
# Gather what a bug or test report needs into one file: pila's version, the
# system, the GPU and driver, the monitors, whether the config is valid, and
# the end of the log. Your home directory, user name and host name are taken
# out, but window titles, commands and file names in the log stay: read it
# before posting it. Nothing is sent anywhere.
#
#   scripts/report [file]       (default: pila-report.txt here)
#
# Installed as pila-report (scripts/install, or the AUR package).
set -uo pipefail

# How much of the log goes in.
LOG_LINES=300

output="${1:-pila-report.txt}"
case "$output" in
    -h | --help)
        sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
        exit 0
        ;;
esac

user="${USER:-$(id -un 2>/dev/null || true)}"
host="$(uname -n 2>/dev/null || true)"

# `word` in `replaced` becomes `with`, as a whole word only: inside another one
# (a user "roy" in "destroy") it stays, as replacing it would mangle the text and
# show what the name is.
replace_word() {
    local word="$1" with="$2" text="$replaced" before after out=""
    while [[ "$text" == *"$word"* ]]; do
        before="${text%%"$word"*}"
        after="${text#*"$word"}"
        if [[ "$before" =~ [[:alnum:]_]$ || "$after" =~ ^[[:alnum:]_] ]]; then
            out+="$before$word"
        else
            out+="$before$with"
        fi
        text="$after"
    done
    replaced="$out$text"
}

# The host first: it often has the user name in it. Short names are left
# alone, as they're easily ordinary words.
redact() {
    local line replaced
    while IFS= read -r line || [ -n "$line" ]; do
        [ -n "${HOME:-}" ] && line="${line//"$HOME"/\~}"
        replaced="$line"
        [ "${#host}" -ge 3 ] && replace_word "$host" "<host>"
        [ "${#user}" -ge 3 ] && replace_word "$user" "<user>"
        printf '%s\n' "$replaced"
    done
}

# The pila this checkout built, if it's run from one, else the installed one.
find_pila() {
    local root
    root="$(dirname "$(readlink -f "$0")")/.."
    if command -v pila >/dev/null; then
        command -v pila
    elif [ -x "$root/target/release/pila" ]; then
        echo "$root/target/release/pila"
    elif [ -x "$root/target/debug/pila" ]; then
        echo "$root/target/debug/pila"
    fi
}

os_name() {
    if [ -r /etc/os-release ]; then
        (. /etc/os-release && echo "${PRETTY_NAME:-${NAME:-unknown}}")
    else
        echo unknown
    fi
}

section_system() {
    echo "## System"
    echo "OS: $(os_name)"
    echo "Kernel: $(uname -sr)"
    echo "Init: $(cat /proc/1/comm 2>/dev/null || echo unknown)"
    echo "Session type: ${XDG_SESSION_TYPE:-unset}"
    echo "Desktop: ${XDG_CURRENT_DESKTOP:-unset}"
    echo "Wayland display: ${WAYLAND_DISPLAY:-unset}"
    echo "Xwayland: $(command -v Xwayland >/dev/null && echo installed || echo missing)"
    echo "xdg-open: $(command -v xdg-open >/dev/null && echo installed || echo missing)"
    echo "wl-copy: $(command -v wl-copy >/dev/null && echo installed || echo missing)"
}

section_gpu() {
    local card driver vendor device
    echo "## GPU"
    if command -v lspci >/dev/null; then
        lspci -k 2>/dev/null | grep -EA3 'VGA|3D|Display' | grep -vE '^--|Subsystem'
    else
        for card in /sys/class/drm/card[0-9]; do
            [ -e "$card/device" ] || continue
            driver="$(basename "$(readlink -f "$card/device/driver")")"
            vendor="$(cat "$card/device/vendor" 2>/dev/null)"
            device="$(cat "$card/device/device" 2>/dev/null)"
            echo "$(basename "$card"): driver $driver, PCI $vendor:$device"
        done
    fi
    if [ -r /proc/driver/nvidia/version ]; then
        head -n 1 /proc/driver/nvidia/version
    fi
    gpu_in_use
}

# The device pila draws with (/dev/dri/cardN), from its log; nothing if it
# isn't there. Searched in the whole log: it's logged once, at the start, and
# only by a session on a TTY.
gpu_device() {
    local log gpu
    log="$(find_log)"
    [ -n "$log" ] || return 0
    gpu="$(grep -a 'using GPU' "$log" | tail -n 1 | sed -n 's/.*gpu=\([^[:space:]]*\).*/\1/p')"
    echo "${gpu%$'\033'*}"
}

# With two GPUs (a hybrid laptop), which of them pila draws with.
gpu_in_use() {
    local gpu driver
    [ -n "$(find_log)" ] || return 0
    gpu="$(gpu_device)"
    if [ -z "$gpu" ]; then
        echo "In use by Pila: not in the log"
        return 0
    fi
    driver="$(basename "$(readlink -f "/sys/class/drm/${gpu##*/}/device/driver" 2>/dev/null)" 2>/dev/null)"
    echo "In use by Pila: $gpu${driver:+ (driver $driver)}"
}

# Only what the kernel lists: no EDID, which has the monitor's serial number.
# pila uses one GPU: a monitor wired to another (often a hybrid laptop's
# HDMI or DisplayPort, on the dedicated GPU) doesn't show up, and is marked.
section_monitors() {
    local connector name mode card used note
    echo "## Monitors"
    used="$(gpu_device)"
    used="${used##*/}"
    for connector in /sys/class/drm/card[0-9]*-*; do
        [ -e "$connector/status" ] || continue
        [ "$(cat "$connector/status")" = connected ] || continue
        name="$(basename "$connector")"
        card="${name%%-*}"
        mode="$(head -n 1 "$connector/modes" 2>/dev/null)"
        note=""
        if [ -n "$used" ] && [ "$card" != "$used" ]; then
            note=" (on $card, not the GPU Pila uses: not supported yet, so Pila doesn't show it)"
        fi
        echo "${name#"$card"-}: preferred mode ${mode:-unknown}$note"
    done
}

# Whether it's valid, not what's in it: it can have private commands.
section_config() {
    local pila="$1"
    echo "## Config"
    if [ -z "$pila" ]; then
        echo "not checked: no pila found"
    else
        "$pila" --check-config 2>&1
    fi
}

# The session's log, or that of a run by hand from here if that's newer.
find_log() {
    local log="${XDG_STATE_HOME:-${HOME:-}/.local/state}/pila/pila.log"
    if [ -f pila-tty.log ] && { [ ! -f "$log" ] || [ pila-tty.log -nt "$log" ]; }; then
        log="pila-tty.log"
    fi
    [ -f "$log" ] && echo "$log"
}

section_log() {
    local log
    echo "## Log"
    log="$(find_log)"
    if [ -z "$log" ]; then
        echo "no log found (nested, it's the terminal's output)"
        return
    fi
    echo "$log, last $LOG_LINES lines:"
    tail -n "$LOG_LINES" "$log"
}

pila="$(find_pila)"

# Only for the user until they've read it.
umask 077
if ! {
    echo "# Pila report"
    if [ -n "$pila" ]; then
        "$pila" --version 2>&1
    else
        echo "pila not found"
    fi
    echo
    section_system
    echo
    section_gpu
    echo
    section_monitors
    echo
    section_config "$pila"
    echo
    section_log
} 2>&1 | redact >"$output"; then
    echo "report: can't write $output" >&2
    exit 1
fi

echo "Wrote $output."
echo "Read it before posting it: logs can hold window titles, commands and file names."
echo "Then attach it to https://github.com/igalmarino/pila/issues/new/choose"
