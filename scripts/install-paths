# Where scripts/install puts pila and what scripts/uninstall removes; sourced
# by both. Override with environment variables, the usual ones for packaging:
#
#   PREFIX       /usr/local     (PREFIX=/usr for display managers that only
#                               read /usr/share/wayland-sessions)
#   BINDIR       $PREFIX/bin
#   DATADIR      $PREFIX/share
#   SYSCONFDIR   /etc           (the portal configs go in $SYSCONFDIR/xdg)
#   SYSTEMDUSERUNITDIR  $PREFIX/lib/systemd/user  (pila.service; systemd
#                               looks in /usr/lib and /usr/local/lib; files
#                               nothing reads where there's no systemd)
#   DESTDIR      empty          (a staging root, e.g. for a distro package)
#
# shellcheck shell=bash

PREFIX="${PREFIX:-/usr/local}"
BINDIR="${BINDIR:-$PREFIX/bin}"
DATADIR="${DATADIR:-$PREFIX/share}"
SYSCONFDIR="${SYSCONFDIR:-/etc}"
SYSTEMDUSERUNITDIR="${SYSTEMDUSERUNITDIR:-$PREFIX/lib/systemd/user}"
DESTDIR="${DESTDIR:-}"
# pila-check's helpers, where it looks for them: share/pila/check next to the
# directory it's in.
CHECKDIR="$(dirname "$BINDIR")/share/pila/check"

# source in the repository : installed path (before DESTDIR) : mode
install_files=(
    "target/release/pila:$BINDIR/pila:755"
    "resources/session/pila-session:$BINDIR/pila-session:755"
    "scripts/report:$BINDIR/pila-report:755"
    "scripts/check:$BINDIR/pila-check:755"
    "scripts/toplevel-action:$CHECKDIR/toplevel-action:644"
    "scripts/workspace-action:$CHECKDIR/workspace-action:644"
    "scripts/capture-stream:$CHECKDIR/capture-stream:644"
    "docs/pila.1:$DATADIR/man/man1/pila.1:644"
    "resources/session/pila.desktop:$DATADIR/wayland-sessions/pila.desktop:644"
    "resources/session/pila.service:$SYSTEMDUSERUNITDIR/pila.service:644"
    "resources/session/pila-shutdown.target:$SYSTEMDUSERUNITDIR/pila-shutdown.target:644"
    "resources/icons/pila.svg:$DATADIR/icons/hicolor/scalable/apps/pila.svg:644"
    "resources/portals/pila.portal:$DATADIR/xdg-desktop-portal/portals/pila.portal:644"
    "resources/xdg/xdg-desktop-portal/pila-portals.conf:$SYSCONFDIR/xdg/xdg-desktop-portal/pila-portals.conf:644"
    "resources/xdg/xdg-desktop-portal-wlr/pila:$SYSCONFDIR/xdg/xdg-desktop-portal-wlr/pila:644"
)

# What an older install put there and Pila no longer has: scripts/install and
# scripts/uninstall remove them.
removed_files=(
    "$BINDIR/pila-launcher"
    "$BINDIR/pila-bar"
    "$BINDIR/pila-osd"
    "$BINDIR/pila-shot"
    "$BINDIR/pila-switcher"
    "$BINDIR/pila-wallpaper"
)

# Directories that may be left empty by an uninstall.
install_dirs=(
    "$CHECKDIR"
    "$(dirname "$CHECKDIR")"
    "$DATADIR/wayland-sessions"
    "$SYSTEMDUSERUNITDIR"
    "$SYSCONFDIR/xdg/xdg-desktop-portal"
    "$SYSCONFDIR/xdg/xdg-desktop-portal-wlr"
    "$DATADIR/xdg-desktop-portal/portals"
    "$DATADIR/xdg-desktop-portal"
)

# Runs a command with sudo only if $1's directory (or its nearest existing
# ancestor) isn't writable, so a DESTDIR install needs no root.
as_owner_of() {
    local dir
    dir="$(dirname "$1")"
    shift
    while [ ! -e "$dir" ]; do dir="$(dirname "$dir")"; done
    if [ -w "$dir" ]; then
        "$@"
    else
        sudo "$@"
    fi
}
