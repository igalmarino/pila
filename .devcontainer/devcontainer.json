{
  "name": "Wayland compositor (Rust + Smithay)",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "TZ": "${localEnv:TZ:America/Costa_Rica}",
      "FULL_SUDO": "false"
    }
  },

  // Non-root user; on Linux its UID/GID is rewritten to match your host user,
  // which is required to connect to the host Wayland socket.
  "remoteUser": "dev",
  "updateRemoteUserUID": true,

  "runArgs": [
    // GPU for EGL/GLES rendering (Intel/AMD via Mesa).
    "--device=/dev/dri"
  ],

  "mounts": [
    // Only a Wayland socket to the host compositor, not the whole
    // XDG_RUNTIME_DIR (which would also expose D-Bus, PipeWire, the keyring,
    // ...). On pila it's sandboxed: no screen capture or virtual keyboard
    // (scripts/link-wayland).
    "source=${localEnv:XDG_RUNTIME_DIR}/pila-devcontainer,target=/run/host-wayland,type=bind",
    // The pila login session's log (resources/session/pila-session), so Claude
    // can read it: /run/host-pila/pila.log and pila.log.old.
    "source=${localEnv:HOME}/.local/state/pila,target=/run/host-pila,type=bind,readonly",
    // Claude Code auth/settings/history survive rebuilds.
    "source=claude-code-config-${devcontainerId},target=/home/dev/.claude,type=volume",
    // The GitHub CLI login (gh auth login), so pushes keep working after a rebuild.
    "source=gh-config-${devcontainerId},target=/home/dev/.config/gh,type=volume",
    // Crate download cache survives rebuilds.
    "source=cargo-registry-${devcontainerId},target=/home/dev/.cargo/registry,type=volume",
    "source=bashhistory-${devcontainerId},target=/commandhistory,type=volume"
  ],

  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/dev/.claude",
    // Clients started in the container (including your nested compositor's
    // winit window) connect straight to GNOME through the mounted socket.
    "WAYLAND_DISPLAY": "/run/host-wayland/wayland-0",
    // Private runtime dir where your compositor creates its own socket.
    "XDG_RUNTIME_DIR": "/tmp/xdg-runtime",
    "RUST_BACKTRACE": "1"
  },

  // Makes a socket for the current session in the mounted directory
  // (scripts/link-wayland; scripts/dev refreshes it before every command), and
  // makes sure the log directory exists before Docker mounts it (a missing
  // bind source would be created as root).
  "initializeCommand": "scripts/link-wayland && mkdir -p \"${XDG_STATE_HOME:-$HOME/.local/state}/pila\"",

  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",

  "postStartCommand": "/usr/local/bin/post-start.sh",
  "waitFor": "postStartCommand",

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb",
        "tamasfe.even-better-toml"
      ],
      "settings": {
        "rust-analyzer.check.command": "clippy",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
