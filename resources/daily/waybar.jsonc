// waybar for pila: minimal, icons instead of words, and only modules that work
// without sway's IPC (pila offers no taskbar or workspace protocol).
// Installed as ~/.config/pila/waybar.jsonc, styled by ~/.config/pila/waybar.css.
//
// Icons come from Symbols Nerd Font (Arch: ttf-nerd-fonts-symbols); the code
// points are Font Awesome's, so Font Awesome works as well. Hover a module for
// the details.
{
    "layer": "top",
    "position": "top",
    "height": 24,
    "spacing": 0,
    "modules-left": [],
    "modules-center": ["clock"],
    "modules-right": ["tray", "idle_inhibitor", "wireplumber", "network", "battery"],
    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },
    // eye: the screen stays awake; nothing shown otherwise.
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": { "activated": "\uf06e", "deactivated": "\uf070" },
        "tooltip-format-activated": "The screen won't lock or sleep",
        "tooltip-format-deactivated": "Click to keep the screen awake"
    },
    // speaker: off, low, high; muted is the off icon, dimmed.
    "wireplumber": {
        "format": "{icon}",
        "format-muted": "\uf026",
        "format-icons": ["\uf026", "\uf027", "\uf028"],
        "tooltip-format": "Volume {volume}%",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    // wifi, wired (sitemap), offline (broken link).
    "network": {
        "format-wifi": "\uf1eb",
        "format-ethernet": "\uf0e8",
        "format-disconnected": "\uf127",
        "tooltip-format-wifi": "{essid}  {signalStrength}%  {ipaddr}",
        "tooltip-format-ethernet": "{ifname}  {ipaddr}",
        "tooltip-format-disconnected": "Offline"
    },
    // battery level from empty to full; a bolt while charging, a plug when full.
    "battery": {
        "format": "{icon}",
        "format-charging": "\uf0e7",
        "format-plugged": "\uf1e6",
        "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
        "tooltip-format": "Battery {capacity}%  {timeTo}",
        "states": { "warning": 20, "critical": 10 }
    },
    "tray": { "icon-size": 14, "spacing": 8 }
}
