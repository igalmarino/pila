# xdg-desktop-portal-wlr settings for pila sessions (XDG_CURRENT_DESKTOP=pila).
# It only reads ~/.config/xdg-desktop-portal-wlr/pila or /etc/xdg/..., not
# XDG_CONFIG_DIRS: scripts/install puts it in /etc/xdg, and scripts/tty copies
# it to ~/.config if missing.
[screencast]
# Pick the screen to share by clicking it (slurp comes with
# xdg-desktop-portal-wlr). Without this, xdpw wants a dmenu-style menu
# (wmenu, wofi, rofi, bemenu, mew or fuzzel) and fails if none is installed.
# To share single windows too, install fuzzel and use instead:
#   chooser_type=dmenu
#   chooser_cmd=fuzzel -d -l 10 -p 'Select a source to share: '
chooser_type=simple
chooser_cmd=slurp -f 'Monitor: %o' -or
